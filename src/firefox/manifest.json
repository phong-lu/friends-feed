{
  "manifest_version": 3,
  "name": "Facebook Friends Feed",
  "version": "3.0.0",
  "description": "Adds a Friends feed shortcut beside Home in Facebook's navigation.",
  "browser_specific_settings": {
    "gecko": {
      "id": "friends-feed@friend-feed.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
